{
  "title": "Spring Boot Integrated Dashboard",
  "tags": [
    "spring-boot",
    "java",
    "mongo",
    "redis"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "hide": 0,
        "includeAll": true,
        "label": "Server",
        "multi": true,
        "name": "server",
        "options": [],
        "query": "label_values(http_server_requests_seconds_count, server)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "title": "HTTP Requests - Total RPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{server=~\"$server\"}[1m]))",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "title": "HTTP Requests - RPS by Server",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server) (rate(http_server_requests_seconds_count{server=~\"$server\"}[1m]))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "title": "Short URL Creation RPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{server=~\"$server\", method=\"POST\", uri=\"/api/v1/data/shorten\"}[1m]))",
          "legendFormat": "Create"
        }
      ]
    },
    {
      "title": "Short URL Redirect RPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{server=~\"$server\", method=\"GET\", uri=\"/api/v1/{shortUrl}\"}[1m]))",
          "legendFormat": "Redirect"
        }
      ]
    },
    {
      "title": "JVM Heap Memory Used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server, id) (jvm_memory_used_bytes{area=\"heap\", server=~\"$server\"})",
          "legendFormat": "{{server}} / {{id}}"
        }
      ]
    },
    {
      "title": "MongoDB Command Execution Rate (per second)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server, command, status) (rate(mongodb_driver_commands_seconds_count{server=~\"$server\"}[1m]))",
          "legendFormat": "{{server}} / Mongo / {{command}} (status: {{status}})"
        }
      ]
    },
    {
      "title": "Redis Command Execution Rate (per second)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server, command) (rate(lettuce_command_completion_seconds_count{server=~\"$server\"}[1m]))",
          "legendFormat": "{{server}} / Redis / {{command}}"
        }
      ]
    },
    {
      "title": "MongoDB Connection Pool",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server) (mongodb_driver_pool_checkedout{server=~\"$server\"})",
          "legendFormat": "{{server}} / Active Connections (Checked Out)"
        },
        {
          "expr": "sum by (server) (mongodb_driver_pool_waitqueuesize{server=~\"$server\"})",
          "legendFormat": "{{server}} / Wait Queue Size (Pending)"
        }
      ]
    },
    {
      "title": "MongoDB Request Duration (Seconds)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server, command) (rate(mongodb_driver_commands_seconds_sum{server=~\"$server\"}[1m])) / sum by (server, command) (rate(mongodb_driver_commands_seconds_count{server=~\"$server\"}[1m]))",
          "legendFormat": "{{server}} / Avg Duration - {{command}}"
        },
        {
          "expr": "max by (server, command) (mongodb_driver_commands_seconds_max{server=~\"$server\"})",
          "legendFormat": "{{server}} / Max Duration - {{command}}"
        }
      ]
    },
    {
      "title": "Redis Request Duration (Seconds)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (server, command) (rate(lettuce_command_completion_seconds_sum{server=~\"$server\"}[1m])) / sum by (server, command) (rate(lettuce_command_completion_seconds_count{server=~\"$server\"}[1m]))",
          "legendFormat": "{{server}} / Avg Duration - {{command}}"
        },
        {
          "expr": "max by (server, command) (lettuce_command_completion_seconds_max{server=~\"$server\"})",
          "legendFormat": "{{server}} / Max Duration - {{command}}"
        }
      ]
    }
  ]
}
